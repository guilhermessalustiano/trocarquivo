<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to trocarquivo.xml next to the renamed WinSW executable in deploy. -->
<service>
  <id>trocarquivo</id>
  <name>Trocarquivo</name>
  <description>Trocarquivo - API de upload e download</description>
  <executable>%ProgramFiles%\nodejs\node.exe</executable>
  <arguments>"%BASE%\..\server.js"</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <startmode>Automatic</startmode>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <onfailure action="restart" delay="5 sec"/>
  <logpath>%ProgramData%\Trocarquivo\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>
</service>
