# Modelo para um servidor dedicado ao Trocarquivo. Ajuste root e server_name.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Aponte somente para public/, nunca para a raiz do projeto ou uploads/.
    root /var/www/trocarquivo/public;
    index index.html;

    # Mesmo limite de 50 MiB aplicado pela API.
    client_max_body_size 50m;
    client_body_timeout 120s;

    add_header X-Content-Type-Options nosniff always;

    location /api/ {
        # Sem barra final: preserva /api/ no caminho enviado ao Node.js.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Transmite uploads e downloads sem criar cópias temporárias no Nginx.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Evita duplicar o cabeçalho definido também pela API.
        proxy_hide_header X-Content-Type-Options;
    }

    # Mantém erros de tamanho no formato JSON esperado pela interface.
    error_page 413 = @upload_too_large;
    location @upload_too_large {
        default_type application/json;
        return 413 '{"error":"O arquivo excede o limite de 50 MB."}';
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}
